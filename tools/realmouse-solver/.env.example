# Copy to .env next to service.py. Never commit .env.
# Shared secret; the server's XIANYU_SLIDER_REMOTE_SECRET must be identical.
SOLVER_SECRET=change-me-to-a-long-random-string
# Keep the service on loopback; the server reaches it through the SSH reverse tunnel.
SOLVER_HOST=127.0.0.1
SOLVER_PORT=18095
# Optional: cap on browser_timeout a caller may request (seconds).
# SOLVER_MAX_BROWSER_TIMEOUT=120
# Optional: DEBUG for trajectory-level logs.
# SOLVER_LOG_LEVEL=INFO
